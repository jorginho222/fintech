<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CreditRequest\Domain\Model\CreditRequest" table="credit_requests">
        <id name="id" type="string" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="totalAmount" column="total_amount" type="decimal" precision="14" scale="4" nullable="false"/>
        <field name="nominalInterestRate" column="nominal_interest_rate" type="decimal" precision="4" scale="2" nullable="false"/>
        <field name="status" column="status" type="string" enumType="App\CreditRequest\Domain\Model\CreditRequestStatus" nullable="false"/>
        <field name="createdAt" column="created_at" type="datetime_immutable" nullable="false"/>

        <many-to-one field="company" target-entity="App\Company\Domain\Model\Company" inversed-by="creditRequestCollection">
            <join-column name="company_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <one-to-many field="installmentCollection" target-entity="App\CreditRequest\Domain\Model\Installment" mapped-by="creditRequest"/>
    </entity>

</doctrine-mapping>
