<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CreditRequest\Domain\Model\Installment" table="installments">
        <id name="id" type="string" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="periodNumber" column="period_number" type="integer" nullable="false"/>
        <field name="capitalAmount" column="capital_amount" type="decimal" precision="14" scale="4" nullable="false"/>
        <field name="interestAmount" column="interest_amount" type="decimal" precision="14" scale="4" nullable="false"/>
        <field name="taxOnInterestAmount" column="tax_on_interest_amount" type="decimal" precision="14" scale="4" nullable="false"/>
        <field name="totalAmount" column="total_amount" type="decimal" precision="14" scale="4" nullable="false"/>
        <field name="dueDate" column="due_date" type="date_immutable" nullable="false"/>
        <field name="status" column="status" type="string" enum-type="App\CreditRequest\Domain\Model\InstallmentStatus" nullable="false"/>

        <many-to-one field="creditRequest" target-entity="App\CreditRequest\Domain\Model\CreditRequest" inversed-by="installmentCollection">
            <join-column name="credit_request_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>

</doctrine-mapping>
